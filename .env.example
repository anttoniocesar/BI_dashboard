NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: demo | supabase. Without keys the default is demo.
NEXT_PUBLIC_DATA_MODE=
# Sample catalog/grants only for an explicitly isolated demo or test server.
# Leave unset for normal /learn, even when using local storage/auth.
NEXT_PUBLIC_DEMO_CATALOG=
# Context is independent of data mode. Production build/start require Supabase.
BI_SOCIETY_APP_ENV=
# Server canonical HTTPS origin (no trailing slash), required in production.
APP_ORIGIN=
# Production catalog uses only the stable deployed pilot course.
NEXT_PUBLIC_PILOT_ONLY=
# Optional direct HTTPS mp4/webm/ogg media. Without them pilot uses text guidance.
NEXT_PUBLIC_PILOT_LESSON_URL=
NEXT_PUBLIC_PILOT_APPLICATION_URL=
# Explicit LOCAL/internal demo preview build only. Never set on the public host.
BI_SOCIETY_ALLOW_DEMO_PREVIEW=
